# Routing for roadkill. Names resolve through Pi-hole's local DNS records: one A
# record per site, all pointing at 192.168.0.231.
#
# `tls internal` means Caddy's own CA, so each client needs the root certificate
# installed once (see the repo README). If a public domain ever points here,
# replace `tls internal` with a DNS-01 challenge and the trust step disappears.
#
# To add a site: attach the service's container to the `edge` network, then add
# a block like the one below. Nothing else in this host's config changes.
{
	# The admin API stays on, on loopback *inside the container*: it is what
	# `caddy reload` talks to, and reloading is how a Caddyfile edit reaches the
	# running server without dropping connections. It is not published, so
	# nothing on the LAN can reach it, and binding loopback keeps it off the
	# container's own interfaces too (verified: another container gets
	# "connection refused").
	#
	# Do not set `admin off` here. It does not mean "no ACME" — it removes the
	# endpoint, and every `caddy reload` then fails with
	# `dial tcp [::1]:2019: connect: connection refused`.
	admin 127.0.0.1:2019
}

# Metabase, from the barkeep pipeline.
barkeep.roadkill.lan {
	tls internal
	reverse_proxy metabase:3000
}

# Open WebUI. The app runs on this host and needs the GPU-backed Ollama that
# stays on the PC, so `pc.lan:11434` is its one upstream this host does not own.
openwebui.roadkill.lan {
	tls internal
	reverse_proxy openwebui:8080
}

# The bare host name is the machine, not an app. Send it to the first real
# service; replace this with a landing page once there are several.
roadkill.lan {
	tls internal
	redir https://barkeep.roadkill.lan{uri}
}
